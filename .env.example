# Copy this file to .env and replace the placeholder values.
# Never commit .env.

# Used by the db service to create the database on first start
POSTGRES_USER=shopassist
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopassist

# Used by the api service. The user, password and database name must match
# the values above. The host is "db", the name of the database service.
DATABASE_URL=postgresql+psycopg://shopassist:change-me@db:5432/shopassist

# Secret used to sign login tokens. Generate a long random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
# How long a login token stays valid, in minutes
JWT_EXPIRE_MINUTES=30

# Name of the store the assistant works for (Loom & Lane is the demo store)
STORE_NAME=Loom & Lane

# AI provider. Only "openrouter" is supported for now.
AI_PROVIDER=openrouter
# A specific free chat model. Avoid openrouter/free: it can route chat to a
# safety classifier that answers "User Safety: safe" instead of replying.
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Chat models tried in order if AI_MODEL can't answer (comma separated)
AI_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free
AI_BASE_URL=https://openrouter.ai/api/v1
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# Give up on an AI reply after this many seconds (45 is the default):
# Ultra thinks before it answers and can take over 20 seconds, and if we give
# up first, OpenRouter never gets to try the fallback model
AI_TIMEOUT_SECONDS=45
# Upper limit on the length of each AI reply
AI_MAX_TOKENS=1000

# Embedding model for the knowledge base (free on OpenRouter)
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Size of each embedding. Must match the database column (set by the
# migration), so only change it together with a new migration.
EMBEDDING_DIMENSIONS=2048

# Knowledge base retrieval: how many chunks to add to each reply at most,
# and the minimum cosine similarity a chunk needs to be used
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.30
# Documents always included in the store information (file names without .md,
# comma separated), so customers always get support contact details
RAG_ALWAYS_INCLUDE=contact

# Knowledge uploads (admin only). Each limit returns 413 when exceeded.
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_MAX_PDF_PAGES=200
UPLOAD_MAX_DOCX_UNCOMPRESSED_BYTES=20971520
UPLOAD_MAX_CHARS=60000
UPLOAD_MAX_CHUNKS=64

# Browser origins allowed to call the API (comma separated, never "*").
# Locally the Vite dev server; in production the Vercel address.
ALLOWED_ORIGINS=http://localhost:5173
