{
  "name": "ShopAssist admin",
  "version": 1,
  "about": "The admin dashboard's design system, taken from web/design/mockups/admin. ShopAssist's own look, separate from the store's (tokens.json). Tailwind names get the prefix below, so they can never collide with the store's: the colour 'accent' is the class bg-sa-accent, the spacing 'space-4' is p-sa-4.",
  "tailwindPrefix": "sa-",
  "color": {
    "tokens": [
      {
        "name": "ground",
        "value": {
          "light": "#F4F4F1"
        },
        "usage": "Page background: a cool off-white."
      },
      {
        "name": "surface",
        "value": {
          "light": "#FFFFFF"
        },
        "usage": "Cards, panels, the sidebar and tables."
      },
      {
        "name": "surface-muted",
        "value": {
          "light": "#FAFAF8"
        },
        "usage": "Quiet fills inside a surface, such as the store chip."
      },
      {
        "name": "surface-sunken",
        "value": {
          "light": "#EEEFEA"
        },
        "usage": "Neutral chips and placeholders."
      },
      {
        "name": "ink",
        "value": {
          "light": "#17201C"
        },
        "usage": "Main text, the selected range button and avatars."
      },
      {
